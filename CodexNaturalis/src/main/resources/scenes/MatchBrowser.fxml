                     <Label alignment="BOTTOM_CENTER" maxHeight="Infinity" maxWidth="Infinity" prefHeight="111.0" prefWidth="204.0" text="Nickname" textFill="#2f0606" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.valignment="CENTER">
                        <font>
                           <Font name="Fira Sans Condensed SemiBold" size="18.0" />
                        </font>
                     </Label>
                     <TextField fx:id="reconnectNicknameTextbox" onKeyTyped="#checkReconnectInput" promptText="Nickname" styleClass="textField" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <font>
                           <Font name="Fira Sans Condensed Regular" size="14.0" />
                        </font>
                     </TextField>
                     <Button fx:id="reconnectButton" onAction="#tryReconnect"  disable="true" mnemonicParsing="false" onMouseClicked="#tryJoin" text="Reconnect" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="3">
                        <font>
                           <Font name="Fira Sans Condensed Regular" size="14.0" />
                        </font>
                     </Button>
                     <Pane prefHeight="1.0" prefWidth="1.0" styleClass="titleDivider" />
                     <Pane prefHeight="1.0" prefWidth="1.0" styleClass="titleDivider" GridPane.columnIndex="1" />
                     <Pane prefHeight="1.0" prefWidth="1.0" styleClass="titleDivider" GridPane.columnIndex="2" />
                  </children>
               </GridPane>
               <GridPane styleClass="titleBackground">
                  <columnConstraints>
                     <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="20.0" prefWidth="100.0" />
                     <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                     <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="20.0" prefWidth="100.0" />
                  </columnConstraints>
                  <rowConstraints>
                     <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  </rowConstraints>
                  <children>
                     <ImageView fx:id="backFromReconnectIcon" fitHeight="16.0" fitWidth="16.0" onMouseClicked="#goBackFromPopup" pickOnBounds="true" styleClass="backButton" GridPane.halignment="CENTER" GridPane.valignment="CENTER">
                        <image>
                           <Image url="@images/back.png" />
                        </image>
                     </ImageView>
                     <Label alignment="CENTER" maxHeight="Infinity" maxWidth="Infinity" prefHeight="111.0" prefWidth="204.0" styleClass="titleBackground" text="Reconnect to game" textFill="#2f0606" GridPane.columnIndex="1">
                        <font>
                           <Font name="Fira Sans Condensed SemiBold" size="18.0" />
                        </font>
                     </Label>
                  </children>
               </GridPane>
            </children>
         </GridPane>
      </children>
   </GridPane>
</AnchorPane>
